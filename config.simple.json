{
  "app": {
    "name": "nutrition-api",
    "version": "1.0.0",
    "port": 8080,
    "environment": "development",
    "debug": true
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "nutrition_db",
    "username": "nutrition_user",
    "ssl_mode": "disable",
    "max_connections": 10
  },
  "security": {
    "jwt_secret": "${JWT_SECRET}",
    "jwt_ttl": "24h",
    "api_rate_limit": 100,
    "enable_cors": true,
    "allowed_origins": ["http://localhost:3000"]
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": "stdout"
  },
  "monitoring": {
    "health_check_path": "/health",
    "metrics_enabled": false,
    "tracing_enabled": false
  }
}
