# 🔒 Production Environment Configuration Template
# Copy this file to .env.production and fill in actual values
# NEVER commit this file with real values!

# Server Configuration
PORT=8081
HOST=0.0.0.0
ENV=production
APP_NAME=DoctorHealthy1
APP_VERSION=1.0.0
GIN_MODE=release

# Database Configuration
DB_PATH=/app/data/apikeys.db

# Security Configuration
# Generate secure JWT secret: openssl rand -hex 32
JWT_SECRET=[0;34m[INFO][0m Generating secure JWT secret...0ed1c6767dd3d61e9888383c1e2d6ee2c6a2dba0ab6b501d1200ba9fbe08d4eb
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://super.doctorhealthy1.com,https://api.doctorhealthy1.com

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1m

# Logging
LOG_LEVEL=info
ENABLE_DEBUG=false

# External Service Configuration
# Obtain these from service providers
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
GITHUB_TOKEN=CHANGE_ME_GITHUB_TOKEN

# Coolify Configuration
COOLIFY_API_TOKEN=CHANGE_ME_COOLIFY_TOKEN
COOLIFY_APP_UUID=CHANGE_ME_APP_UUID

# Docker Configuration (if applicable)
DOCKER_USERNAME=CHANGE_ME_DOCKER_USERNAME
DOCKER_PASSWORD=CHANGE_ME_DOCKER_PASSWORD

# Email for SSL/TLS (if applicable)
SSL_EMAIL=admin@doctorhealthy1.com

# Monitoring Configuration
METRICS_ENABLED=true
HEALTH_CHECK_PATH=/health

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Security Headers Configuration
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
