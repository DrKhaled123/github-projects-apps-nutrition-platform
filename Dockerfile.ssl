FROM nginx:alpine

# Install certbot for SSL
RUN apk add --no-cache certbot certbot-nginx

# Copy nutrition platform files
COPY frontend/ /usr/share/nginx/html/
COPY nginx_ssl_proxy.conf /etc/nginx/conf.d/default.conf

# Create SSL certificate directory
RUN mkdir -p /etc/letsencrypt/live/my.doctorhealthy1.com

# Expose HTTP and HTTPS
EXPOSE 80 443

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
