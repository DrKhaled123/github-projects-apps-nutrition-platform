// SOLUTION 5: Custom fetch wrapper with cache control
async function fetchWithCache(url, options = {}) {
  const defaultOptions = {
    next: {
      revalidate: process.env.NODE_ENV === 'production' ? 3600 : 0
    }
  };
  
  return fetch(url, { ...defaultOptions, ...options });
}

