// app/components/RefreshButton.tsx
'use client';
import { useRouter } from 'next/navigation';

export function RefreshButton() {
  const router = useRouter();
  
  return (
    <button
      onClick={() => {
        router.refresh(); // Invalidates router cache
      }}
