# Production Environment Configuration
# Copy this file to .env and fill in your values

# Application Configuration
ENVIRONMENT=production
PORT=8080
APP_SECRET_KEY=your-super-secret-key-here-please-change-this
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/nutrition_platform
POSTGRES_DB=nutrition_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379
REDIS_HOST=localhost

# External Services
API_KEY_GENERATOR_URL=http://localhost:8081
COOLIFY_API_URL=https://your-coolify-instance.com
COOLIFY_API_TOKEN=your-coolify-api-token

# Monitoring Configuration
ENABLE_MONITORING=true
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-password

# Security Configuration
CORS_ORIGIN=https://yourdomain.com
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-32-character-encryption-key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # 1 hour in seconds

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/app.crt
SSL_KEY_PATH=/etc/ssl/private/app.key

# Feature Flags
ENABLE_ORCHESTRATION=true
ENABLE_AI_SERVICES=true
ENABLE_ANALYTICS=true
ENABLE_USER_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true

# Performance Configuration
WORKER_PROCESSES=4
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30
READ_TIMEOUT=60
WRITE_TIMEOUT=60

# Logging Configuration
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=104857600  # 100MB
LOG_MAX_FILES=10
LOG_FORMAT=json

# Development/Debug Configuration (Keep false in production)
DEBUG=false
ENABLE_DEBUG_ROUTES=false
ENABLE_PROFILING=false

# Dokploy Specific Configuration
DOKPLOY_APP_NAME=nutrition-platform
DOKPLOY_DEPLOYMENT_URL=https://your-dokploy-instance.com
DOKPLOY_TOKEN=your-dokploy-deployment-token

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Cache Configuration
CACHE_TTL=3600  # 1 hour
CACHE_PREFIX=nutrition_platform

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_TIMEOUT=86400  # 24 hours

# API Configuration
API_VERSION=v1
API_BASE_URL=https://yourdomain.com/api
API_RATE_LIMIT=1000

# Analytics Configuration
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
ENABLE_GOOGLE_ANALYTICS=false

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'
